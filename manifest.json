{
  "manifest_version": 3,
  "name": "Price Dashboard",
  "version": "1.5.0",
  "description": "实时加密货币、股票价格与持仓资产估值",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.okx.com/*",
    "https://query1.finance.yahoo.com/*"
  ]
}
