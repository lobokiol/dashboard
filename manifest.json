{
  "manifest_version": 3,
  "name": "Price Dashboard",
  "version": "1.27.0",
  "minimum_chrome_version": "127",
  "description": "实时加密货币、股票价格与持仓资产估值",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "open-dashboard": {
      "suggested_key": {
        "default": "Alt+G"
      },
      "description": "打开资产看板"
    },
    "open-dashboard-global": {
      "suggested_key": {
        "default": "Ctrl+Shift+7"
      },
      "description": "全局打开资产看板",
      "global": true
    }
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "https://www.okx.com/*",
    "https://query1.finance.yahoo.com/*"
  ]
}
